{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ak5/charon/contracts/data-plane-receipt.schema.json",
  "title": "Charon data-plane receipt envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt", "chain"],
  "properties": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["realm", "workload", "capability", "service", "destination", "method", "path", "status", "delivered_bytes", "elapsed_ms", "outcome"],
      "properties": {
        "realm": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workload": { "type": "string", "minLength": 1, "maxLength": 128 },
        "capability": { "type": "string", "minLength": 1, "maxLength": 128 },
        "service": { "type": "string", "minLength": 1, "maxLength": 128 },
        "destination": { "type": "string", "minLength": 1, "maxLength": 253 },
        "method": { "type": "string", "minLength": 1, "maxLength": 32 },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "delivered_bytes": { "type": "integer", "minimum": 0 },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "outcome": { "enum": ["completed", "interrupted", "response-sanitization-failed", "denied"] }
      }
    },
    "chain": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
